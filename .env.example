# Copy to .env — never commit real secrets
MOCK_LLM=true
MODEL_NAME=mock-llm
SYSTEM_PROMPT=You are a helpful assistant for internal use only.
POLICY_PATH=policies/default.yaml
# Optional OpenAI-compatible upstream (used when MOCK_LLM=false)
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
# Optional Splunk HEC (unset = log JSON decisions to stdout)
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=llm_events
# Local Splunk uses a self-signed HEC cert: set false only for local/Docker
SPLUNK_HEC_VERIFY_SSL=true
# Required only by docker-compose for the Splunk container (never commit it)
SPLUNK_PASSWORD=
